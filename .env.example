OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI direct, embeddings only (decision 278.a): a project key allowed text-embedding-3-small and nothing else
CORPUS_OPENAI_API_KEY=sk-...

# The search server over HTTP (decision 77.a): a shared token the MCP client sends as a Bearer header
CORPUS_SEARCH_TOKEN=

# The index database (issue #10): the password of its user, read by Compose and the code; never committed
CORPUS_DB_PASSWORD=
# pgAdmin in the browser (development only); admin where it is not set
CORPUS_PGADMIN_PASSWORD=
