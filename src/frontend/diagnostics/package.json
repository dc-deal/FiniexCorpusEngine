{
  "name": "diagnostics-ui",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "type-check": "vue-tsc --build --force",
    "types": "openapi-typescript openapi.json -o src/types/api/diagnostics_api.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "knip": "knip"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tabler/icons-vue": "^3.50.0",
    "axios": "^1.21.0",
    "dompurify": "^3.4.17",
    "katex": "0.19.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.10.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
